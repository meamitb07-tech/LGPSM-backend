PORT=5000
NODE_ENV=development
atlas_URL=mongodb+srv://<username>:<password>@<cluster-host>/?appName=<app-name>
DNS_SERVER=8.8.8.8
FRONTEND_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
